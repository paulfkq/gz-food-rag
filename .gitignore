# ============================================================
# 广州美食 RAG 项目 · Git 忽略规则
# 原则：只提交「源码 + 文档 + 依赖清单」，派生数据/运行时数据/依赖包一律不提交
# ============================================================

# ---------- 数据目录（全部可由脚本重建） ----------
# data/raw/shops.jsonl         <- gen_seed_data.py（固定 seed，可复现）
# data/chunks/chunks.jsonl     <- chunker.py
# data/bm25.pkl / data/qdrant  <- build_index.py（BGE-M3 向量索引，约 25MB）
# data/sessions.db             <- SQLite 会话库（运行时数据，含对话内容）
# data/qdrant/.lock            <- 进程锁文件
data/

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# ---------- 前端依赖与构建产物 ----------
front/node_modules/
front/dist/
front/.vite/
front/test-results/
front/playwright-report/

# ---------- 评估结果（体积大且可重新生成；goldset.jsonl 是基准数据，要提交） ----------
eval/out/

# ---------- 环境变量 / 密钥（本地 LLM key 通过启动命令注入，不落盘） ----------
.env
.env.*
!.env.example
# 本地启动脚本含 LLM / 地图 key，禁止提交
scripts/start_backend.sh
traffic/start_traffic.sh
traffic/.env.local
# key 配置模板（无真实值）可提交
!traffic/.env.local.example

# ---------- 日志 / 临时文件 / 系统文件 ----------
*.log
*.tmp
*.swp
.DS_Store
Thumbs.db
